# このファイルをコピーして .env を作成し、実際の値を入力してください。
# 例: cp .env.example .env

# 回答生成用。優先順位は 1) Ollama(無料・ローカル、起動していれば自動検出) 2) ANTHROPIC_API_KEY 3) OPENAI_API_KEY
# Ollamaを使う場合、キーの設定は不要です（インストールしてモデルをpullするだけ）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 任意: Ollamaの設定を変えたい場合のみ
# OLLAMA_MODEL=llama3.1        # 使用するローカルモデル名（デフォルト: llama3.1）
# DISABLE_OLLAMA=true          # Ollamaが起動していてもあえて使わない場合はtrueに

# 任意: LangSmithでトレースを見たい場合のみ設定
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=default

# 埋め込み（ドキュメント検索用）はHuggingFaceのローカルモデルを使うため
# 追加のAPIキーは不要です。

# 任意: Google Drive連携（google_drive_sync.py）を使う場合のみ。事前セットアップ手順は
# docs/google-drive-setup.md を参照してください。
# GOOGLE_DRIVE_FOLDER_ID=                          # 同期対象のDriveフォルダID
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=.credentials/client_secret.json
# GOOGLE_OAUTH_TOKEN_FILE=.credentials/token.json
